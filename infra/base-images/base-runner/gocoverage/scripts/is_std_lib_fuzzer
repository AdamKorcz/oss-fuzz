#!/bin/bash

# Path to the JSON list file
FILE="$OUT/native_go_fuzzers.json"

# Element to check
CHECK_ELEMENT="$1"

# Ensure an element was provided
if [ -z "$CHECK_ELEMENT" ]; then
  echo "Usage: $0 \"element to check\""
  exit 1
fi

# If file doesn't exist or is empty, return false
if [ ! -s "$FILE" ]; then
  echo "false"
  exit 0
fi

# Use jq to check if the element exists
if jq -e --arg item "$CHECK_ELEMENT" 'index($item) != null' "$FILE" > /dev/null; then
  echo "true"
else
  echo "false"
fi